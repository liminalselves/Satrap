{
  "name": "satrap-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/compress-dist.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e:platform": "node e2e/platform-configuration.mjs --case platform-policy",
    "test:e2e:agent-routing": "node e2e/access-routing.mjs --case agent-routing",
    "test:e2e:status": "node e2e/access-routing.mjs --case backend-platform-status",
    "test:e2e:wake": "node e2e/platform-configuration.mjs --case manual-wake",
    "test:e2e:asr": "node e2e/model-configuration.mjs --case asr-models",
    "test:e2e:forms": "node e2e/startup-forms.mjs --case form-required",
    "test:e2e:edictum": "node e2e/plugin-configuration.mjs --case edictum-settings",
    "test:e2e:plugins": "node e2e/plugin-configuration.mjs --case plugins",
    "test:e2e:plugin-loading": "node e2e/plugin-configuration.mjs --case plugin-loading",
    "test:e2e:auth-startup": "node e2e/startup-forms.mjs --case auth-startup",
    "test:e2e:group-chat": "node e2e/group-configuration.mjs --case group-chat-plugin",
    "test:e2e:main-merge": "node e2e/plugin-configuration.mjs --case main-merge",
    "test:e2e:group-polling": "node e2e/platform-configuration.mjs --case group-polling",
    "test:e2e:scoped-plugin-apply": "node e2e/runtime-applications.mjs --case scoped-plugin-apply",
    "test:e2e:scoped-agent-apply": "node e2e/runtime-applications.mjs --case scoped-agent-apply",
    "test:e2e:runtime-progress": "node e2e/runtime-applications.mjs --case runtime-application-progress",
    "test:e2e:control-plugin-progress": "node e2e/runtime-applications.mjs --case control-plugin-application",
    "test:e2e:friends": "node e2e/account-relations.mjs --case friends",
    "test:e2e:account-requests": "node e2e/account-relations.mjs --case account-requests",
    "test:e2e:group-chat-summaries": "node e2e/group-data.mjs --case group-chat-summaries",
    "test:e2e:group-chat-media": "node e2e/group-data.mjs --case group-chat-media",
    "test:e2e:group-chat-memory-reminders": "node e2e/group-data.mjs --case group-chat-memory-reminders",
    "test:e2e:conversations": "node e2e/conversation-management.mjs --case conversations",
    "test:e2e:platform-archives": "node e2e/conversation-management.mjs --case platform-archives",
    "test:e2e:conversation-users": "node e2e/conversation-management.mjs --case conversation-users",
    "test:e2e:logging": "node e2e/logging-flows.mjs --case log-retention",
    "test:e2e:log-stream": "node e2e/logging-flows.mjs --case log-stream",
    "test:e2e:administrators": "node e2e/access-routing.mjs --case administrators",
    "test:e2e": "node e2e/chat-recovery-flows.mjs --case chat-reconnect",
    "test:e2e:chat-history-media": "node e2e/chat-media-flows.mjs --case chat-history-media",
    "preview": "vite preview",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "benchmark:baseline": "npm run build && node benchmarks/run.mjs --baseline",
    "benchmark:smoke": "npm run build && node benchmarks/run.mjs --smoke",
    "benchmark:test": "node --test benchmarks/*.node-test.mjs",
    "test:e2e:all": "node e2e/run.mjs"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "js-yaml": "^5.2.3",
    "katex": "^0.18.4",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "playwright": "^1.62.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vitest": "^3.2.7"
  }
}
